node_modules/
dist/
# Local-only media and branding. Never include these in Git history, except the app
# logo below (needed for README.md to render it on GitHub). A plain "!" exception
# wouldn't reach into an ignored directory, so this un-ignores the path down to it.
src/assets/*
!src/assets/branding/
src/assets/branding/*
!src/assets/branding/zee-ing-bee-logo.png
resources/
# Generated by scripts/copy-mobile-vendor.cjs from node_modules, src/shared/ and resources/icons/.
src/mobile-remote/vendor/
src/mobile-remote/shared/
src/mobile-remote/icon.png
